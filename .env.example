# ---------------------------------------------------------------------------
# Supabase project (Project Settings → API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public origin used in Open Graph tags and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# ---------------------------------------------------------------------------
# API access
# ---------------------------------------------------------------------------
# Machine credential: every /api route also accepts `X-API-Key: $STORE_API_KEY`.
# Use a long random string. Treat it like an admin password.
STORE_API_KEY=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the API from a browser.
# Leave empty to allow any origin (public reads are open anyway).
CORS_ORIGINS=https://your-deployment.vercel.app,http://localhost:3000

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# Password used by `npm run seed` for the two demo accounts.
SEED_PASSWORD=lumo-demo-2026
